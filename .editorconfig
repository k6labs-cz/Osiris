root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cs,cshtml,razor}]
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true

[*.{json,yml,yaml,csproj,props,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[**/Generated/*.cs]
generated_code = true
