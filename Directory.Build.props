<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- One version for everything in the repository; a release passes -p:Version=<tag without v>. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>k6labs</Authors>
    <Company>k6labs</Company>
    <Product>Osiris</Product>
    <Copyright>Copyright © k6labs</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/k6labs-cz/Osiris</PackageProjectUrl>
    <RepositoryUrl>https://github.com/k6labs-cz/Osiris</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- GitHub Packages takes no .snupkg, so the symbols travel inside the assemblies. -->
    <DebugType>embedded</DebugType>
    <PackageTags>ai;agent;llm;mcp;osiris;k6labs</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>false</IsPackable>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
  </PropertyGroup>

  <!-- Packages (IsPackable in the project): XML docs for IntelliSense, the README and license inside. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
