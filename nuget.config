<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- k6labs packages (Hathor). GitHub Packages asks for a token with read:packages even for public
         packages: export NuGetPackageSourceCredentials_k6labs='Username=<login>;Password=<token>' -->
    <add key="k6labs" value="https://nuget.pkg.github.com/k6labs-cz/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="k6labs">
      <package pattern="k6labs.Hathor" />
      <package pattern="k6labs.Hathor.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
