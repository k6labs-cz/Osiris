<Project Sdk="Microsoft.NET.Sdk">

  <!-- The terminal app: the agent runs inside it, over the workspace of the current folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>osiris</AssemblyName>
    <RootNamespace>Osiris.Cli</RootNamespace>
    <!-- Also a .NET tool: dotnet tool install -g k6labs.Osiris.Cli -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>osiris</ToolCommandName>
    <PackageId>k6labs.Osiris.Cli</PackageId>
    <Description>Osiris in the terminal: an AI agent working over the current folder, configured by .osiris/osiris.json.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Osiris.Core\Osiris.Core.csproj" />
  </ItemGroup>

</Project>
